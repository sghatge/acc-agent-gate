  "policy_text": "# ACC Agent Gate – default policy\n# Every tool call an AI agent makes is checked against this file BEFORE it\n# reaches Adobe Campaign. Decisions: allow | allow_masked | dry_run | needs_approval | block\n# Fail-closed: a tool that is not listed here is blocked.\n\nversion: 1\ninstance: aurora-mkt-prod          # synthetic demo instance\nkill_switch: false                 # true = every write is blocked, reads still work\n\nsession_limits:\n  max_write_calls: 6               # writes (sends, workflow actions) per agent session\n  max_rows_per_query: 500          # agent never pulls bulk recipient data\n\ndata:\n  mask_pii: true                   # emails, phones, names, birth dates masked in results\n\ntools:\n  campaign.discover:\n    mode: allow\n\n  schema.browse:\n    mode: allow\n\n  query.run:\n    mode: allow\n    block_sql_writes: true         # INSERT/UPDATE/DELETE/DROP/... never pass through\n    mask_pii: true\n\n  delivery.qa:\n    mode: allow\n\n  delivery.send:\n    mode: needs_approval\n    require_qa: pass_with_warnings # pass | pass_with_warnings (blockers always stop a send)\n    dual_approval_over: 200000     # very large sends need two humans\n    approver_roles: [market_owner, crm_ops_lead]\n\n  workflow.control:\n    mode: needs_approval\n    block_critical: true           # GDPR purge, unsubscribe sync, etc. are off-limits\n    stage_environment: allow       # agents may operate freely on stage\n\n  js.execute:\n    mode: dry_run                  # JS is analysed and explained, never run by default\n    block_categories: [write, send, workflow, system, egress, admin]\n\nqa:\n  quiet_hours_local: [21, 8]       # no marketing sends 21:00–08:00 market local time\n  subject_max_chars: 50            # Adobe delivery best practice: 50 chars or fewer\n"
}